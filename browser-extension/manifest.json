{
  "manifest_version": 3,
  "name": "GoHub Gấu Pro Bridge",
  "version": "1.3.2",
  "description": "Cầu nối cho Gấu Pro đọc/thao tác trên tab Chrome đang mở (dùng session đăng nhập thật) — chỉ dùng nội bộ GoHub, cài tay, không publish Chrome Web Store.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "notifications",
    "alarms",
    "identity",
    "identity.email",
    "debugger",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://intel-v2.gohub.cloud/*",
        "https://stg-intel-v2.gohub.cloud/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
