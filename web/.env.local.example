# GoHub Intel — ENV mẫu (s190 audit: viết lại đầy đủ, khớp process.env.* thật dùng trong code).
# KHÔNG commit giá trị thật vào file này — chỉ placeholder. Giá trị thật set trên Vercel
# (Project Settings → Environment Variables), tick đủ scope Production + Preview cho biến nào
# cần cả 2 (đặc biệt ANALYTICS_DB_* — thiếu scope Preview từng gây query trả rỗng âm thầm, xem
# docs/wiki/system/operations-runbook.md).

# ── Auth / App core ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://wfuigmfnfcijkvylrwzz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
# Random string ≥32 ký tự — tự sinh 1 lần, KHÔNG đổi sau khi đã có user login (đổi = mọi session hiện tại bị đăng xuất).
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://stg-intel-v2.gohub.cloud
# Bearer token cho cron routes (Vercel Cron + GitHub Actions gọi vào /api/cron/*) — random string tự chọn.
CRON_SECRET=
# Bearer token cho MCP server (Claude Code gọi /api/mcp) — random string tự chọn.
MCP_SECRET=

# ── Gemini (chatbot Bé Gấu/Gấu Pro + embeddings KB) ──────────────────────────
# ⚠️ CHỈ 1 biến này — code dùng thống nhất GEMINI_KEY (đã fix s190: 1 file lỡ viết GEMINI_API_KEY
# khiến searchKnowledgeBase luôn lỗi "chưa set" dù GEMINI_KEY đã có, đừng set thêm biến khác tên).
GEMINI_KEY=AIza...

# ── gohub_dw — GCP Postgres, nguồn analytics (read-only) ─────────────────────
ANALYTICS_DB_HOST=
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=
ANALYTICS_DB_USER=
ANALYTICS_DB_PASSWORD=
# Optional — cert CA từ GCP Cloud SQL để bật rejectUnauthorized:true (SSL verify đầy đủ). Thiếu thì
# vẫn chạy được (rejectUnauthorized:false, log cảnh báo) — không bắt buộc để app hoạt động.
ANALYTICS_DB_SSL_CA=

# ── Turso (config intel: country_codes/GA4 config, B2B cost, quarterly targets) ──
TURSO_URL=libsql://...
TURSO_AUTH_TOKEN=
# Turso chat-center — DB RIÊNG cho leads B2C, TÁCH khỏi TURSO_URL ở trên.
TURSO_LEADS_URL=libsql://...
TURSO_LEADS_AUTH_TOKEN=

# ── Lark (Bé Gấu bot + OAuth cá nhân + Cà Thread + My Metrics capture) ───────
LARK_APP_ID=
LARK_APP_SECRET=
# Chữ ký webhook /api/lark/events dùng SHA256(timestamp+nonce+ENCRYPT_KEY+body) — PHẢI lấy đúng
# "Encrypt Key" trong Lark Developer Console (app có bật Encrypt), KHÔNG phải Verification Token
# (biến LARK_VERIFICATION_TOKEN cũ đã ngừng dùng từ s176 — có set cũng không còn tác dụng, có thể xoá).
LARK_ENCRYPT_KEY=
# open_id cá nhân của Hiếu (nhận DM cảnh báo, gán Lark Task cá nhân, review learning...).
LARK_CREATOR_USER_ID=
LARK_BASE_ID=
LARK_TABLE_ID=
LARK_BOT_NAME=

# ── Rate limit cross-instance (Phase 4, tuỳ chọn) ────────────────────────────
# Thiếu 2 biến này → tự rơi về in-memory rate-limit cũ (đúng nhưng chỉ per-instance, không
# opt-in bắt buộc để app chạy). Tạo tài khoản Upstash Redis (free tier) để có giá trị.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Gấu Pro — gen ảnh/video trả phí (admin/creator-only sau s190) ────────────
STABILITY_API_KEY=
KLING_API_KEY=
# Key mã hoá credential portal NCC lưu trong Supabase (browsePortal/managePortalCredentials) — random
# string bất kỳ, code tự pad/cắt về đúng 32 byte cho AES-256-GCM.
PORTAL_CRED_KEY=

# ── BC Datapool (cron bc-sync, tra cứu F011/F012/F023/F046) ──────────────────
# ⚠️ Trạng thái tại s190: AppSecret hiện tại vẫn SAI (BC luôn trả [1008] Signature verification
# failed) — chờ Hiếu lấy secret đúng từ BC support, xem docs/session_summary.txt mục BC Datapool.
BC_DATAPOOL_BASE_API_URL=
BC_DATAPOOL_CHANNEL_ID=GohubDataPool
BC_DATAPOOL_APP_SECRET=
BC_DATAPOOL_SIGN_METHOD=

# ── Tích hợp khác ─────────────────────────────────────────────────────────────
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
ADMIN_GOHUB_API_BASE_URL=https://api.gohub.com
ADMIN_GOHUB_API_KEY=ik_...
ADMIN_GOHUB_API_SECRET=is_...
ADMIN_GOHUB_USD_TO_VND=25000
ADMIN_GOHUB_CUSTOMER_MAX_PAGES_PER_MONTH=
OMNI_API_BASE_URL=https://omni.gohub.cloud
OMNI_API_TOKEN=

# ── Đã xoá khỏi code, KHÔNG cần set nữa (s190 audit — nếu còn trên Vercel, xoá cho gọn) ──
# LARK_VERIFICATION_TOKEN  — thay bằng LARK_ENCRYPT_KEY (xem trên), code không đọc biến này nữa.
# OMNI_WEBHOOK_SECRET      — chưa từng có route webhook nào đọc biến này (chỉ nằm trong comment cũ).
# URL                      — biến Netlify tự inject, dự án đã chuyển hẳn sang Vercel từ lâu.
